diff --git a/pyfive/misc_low_level.py b/pyfive/misc_low_level.py
index 8e81104..5a445e2 100644
--- a/pyfive/misc_low_level.py
+++ b/pyfive/misc_low_level.py
@@ -795,3 +795,22 @@ FRACTAL_HEAP_HEADER = OrderedDict(
         ("indirect_current_rows_count", "H"),
     )
 )
+
+
+def vlen_from_buffer(fh, buf, global_heaps, shape, dtype, decode_strings=False):
+    """Local patch: parse vlen-string heap IDs from an already-decompressed chunk."""
+    count = prod(shape)
+    value = np.empty(count, dtype=object)
+    offset = 0
+    for i in range(count):
+        gheap_id = _unpack_struct_from(GLOBAL_HEAP_ID, buf, offset + 4)
+        addr = gheap_id["collection_address"]
+        if addr == 0:
+            value[i] = b""; offset += 16; continue
+        if addr not in global_heaps:
+            global_heaps[addr] = GlobalHeap(fh, addr)
+        value[i] = global_heaps[addr].objects[gheap_id["object_index"]]
+        offset += 16
+    if decode_strings:
+        value = _convert_string_objects(value, dtype.encoding.lower())
+    return value
